# Контекст сборки backend-образа. Пользовательские файлы (uploads/, attachments/)
# в образ попадать не должны: они монтируются томами, а в образе только
# раздувают контекст и копируют чужие данные в слои. tests/ НЕ исключаем —
# сервис backend-test берёт тесты из образа (у него нет bind-mount кода).
uploads
attachments
**/__pycache__
**/*.pyc
.pytest_cache
.env

# Любые env-файлы на любой глубине (например backend/app/.env.local)
**/.env*
