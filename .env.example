# Copy to .env and fill in. .env is never committed.
#
# Quick fill for local development:
#   sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 16)|" .env
#   sed -i "s|^POSTGRES_TEST_PASSWORD=.*|POSTGRES_TEST_PASSWORD=$(openssl rand -hex 16)|" .env
#   sed -i "s|^MESSAGE_ENCRYPTION_KEY=.*|MESSAGE_ENCRYPTION_KEY=$(python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())')|" .env

# --- Required ---------------------------------------------------------
POSTGRES_PASSWORD=change-me
POSTGRES_TEST_PASSWORD=change-me
SECRET_KEY=change-me
# Fernet key for private messages: 32 random bytes, urlsafe base64 (see command above)
MESSAGE_ENCRYPTION_KEY=change-me

# --- Sign-up protection (Cloudflare Turnstile) -------------------------
# Sign-up is blocked while the secret is empty. The site key is public and is baked into the
# frontend at BUILD time (rebuild the frontend after changing it); the secret stays on the server.
# The two values below are Cloudflare's public TEST keys: they always pass. Local development
# ONLY. For production create a widget for your domain in the Cloudflare dashboard.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Mail ---------------------------------------------------------------
# Defaults point at the Mailpit container from the dev override (UI: http://localhost:8025).
# In production use your real SMTP relay: password reset sends email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Google sign-in (optional) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Local AI via Ollama (optional; defaults shown) -----------------------
# OLLAMA_URL=http://host.docker.internal:11434/v1/chat/completions
# OLLAMA_MODEL=qwen2.5-custom

# --- Production on a domain (see "Production deployment" in the README) ---
# SITE_ADDRESS=meridian.example.com
# Only if the API is served from a different origin than the site (comma-separated):
# CORS_ORIGINS=https://meridian.example.com
# Empty = automatic: login cookies are Secure when ENVIRONMENT=production (the default of
# docker-compose.yml). Set false only for a plain-HTTP trial.
# COOKIE_SECURE=
# Host ports of the proxy in docker-compose.prod.yml (defaults 80 and 443):
# HTTP_PORT=80
# HTTPS_PORT=443
