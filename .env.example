# Copy to .env and fill in. .env is never committed.
#
# Quick fill for local development:
#   sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 16)|" .env
#   sed -i "s|^POSTGRES_TEST_PASSWORD=.*|POSTGRES_TEST_PASSWORD=$(openssl rand -hex 16)|" .env
#   sed -i "s|^MESSAGE_ENCRYPTION_KEY=.*|MESSAGE_ENCRYPTION_KEY=$(python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())')|" .env

# --- Required ---------------------------------------------------------
POSTGRES_PASSWORD=change-me
POSTGRES_TEST_PASSWORD=change-me
SECRET_KEY=change-me
# Fernet key for private messages: 32 random bytes, urlsafe base64 (see command above)
MESSAGE_ENCRYPTION_KEY=change-me

# --- Sign-up protection (Cloudflare Turnstile) -------------------------
# Sign-up is blocked while this is empty. The value below is Cloudflare's public test
# secret: it always passes. Local development ONLY; use a real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Mail ---------------------------------------------------------------
# Defaults point at the Mailpit container from the dev override (UI: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Google sign-in (optional) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Local AI via Ollama (optional; defaults shown) -----------------------
# OLLAMA_URL=http://host.docker.internal:11434/v1/chat/completions
# OLLAMA_MODEL=qwen2.5-custom

# --- Production hardening ----------------------------------------------------
# Set to true behind HTTPS: marks the login cookies Secure. Keep false for plain-http local development.
COOKIE_SECURE=false
